# ═════════════════════════════════════════════════════════════
# Copie para .env e preencha TODOS os valores antes do deploy:
#   cp .env.example .env
# NUNCA envie o arquivo .env para o GitHub.
# Gere senhas fortes com:  openssl rand -base64 32
# ═════════════════════════════════════════════════════════════

# ── Banco de dados ───────────────────────────────────────────
# A senha DEVE ser identica nas duas linhas.
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://platform:troque-esta-senha@postgres:5432/platform?schema=public

# ── Redis (limite de tentativas de login/formularios) ────────
REDIS_PASSWORD=troque-esta-senha-redis
REDIS_URL=redis://:troque-esta-senha-redis@redis:6379

# ── Armazenamento de arquivos (MinIO / S3) — opcional ────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=platform-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=troque-esta-senha-minio

# ── Autenticacao ─────────────────────────────────────────────
# Obrigatorio. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=gere-um-segredo-longo-e-aleatorio
# URL publica COM https e SEM barra final. Ex.: https://kelven.studio
NEXTAUTH_URL=http://localhost:3000

# OAuth e opcional: deixe em branco para esconder os botoes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ── Primeiro administrador (usado pelo seed) ─────────────────
# Senha com no minimo 12 caracteres. Depois do primeiro deploy voce pode
# apagar estas duas linhas do .env.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Aplicacao (embutidas no build: altere ANTES do build) ────
# Mesma URL publica do NEXTAUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@kelven.studio
# Apenas numeros, com DDI e DDD. Ex.: 5535999999999. Vazio = botao escondido.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Pagamentos (Stripe) ──────────────────────────────────────
# Producao: chaves "sk_live_..." e o segredo do webhook cadastrado em
# https://dashboard.stripe.com/webhooks apontando para
#   https://SEU-DOMINIO/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#          checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=sk_test_troque
STRIPE_WEBHOOK_SECRET=whsec_troque
