# ─────────────────────────────────────────────────────────────
# Banco de dados
# ─────────────────────────────────────────────────────────────
# A senha DEVE ser identica a POSTGRES_PASSWORD abaixo. Na versao anterior
# o .env.example usava "platform" e o compose criava o banco com
# "change-me" — a aplicacao nunca conectava.
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://platform:troque-esta-senha@postgres:5432/platform?schema=public

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
# O compose sobe o Redis com --requirepass, entao a senha PRECISA estar na URL.
REDIS_PASSWORD=troque-esta-senha-redis
REDIS_URL=redis://:troque-esta-senha-redis@redis:6379

# ─────────────────────────────────────────────────────────────
# Armazenamento de arquivos (MinIO / S3)
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=platform-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=troque-esta-senha-minio

# ─────────────────────────────────────────────────────────────
# Autenticacao
# ─────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=gere-um-segredo-longo-e-aleatorio
# Em producao use a URL publica COM https e sem barra final.
NEXTAUTH_URL=http://localhost:3000

# OAuth e opcional: deixe em branco para esconder os botoes na tela de login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ─────────────────────────────────────────────────────────────
# Aplicacao
# ─────────────────────────────────────────────────────────────
# Faltava no arquivo original. Sem esta variavel a success_url enviada ao
# Stripe virava "undefined/dashboard?success=true" e a sessao era recusada.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Pagamentos
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_troque
STRIPE_WEBHOOK_SECRET=whsec_troque
MERCADOPAGO_ACCESS_TOKEN=
