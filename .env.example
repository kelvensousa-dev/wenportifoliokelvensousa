# ─────────────────────────────────────────────────────────────
# Kelven Studio — variáveis de ambiente
# Copie para .env (cp .env.example .env) e preencha.
# NUNCA faça commit do .env.
# Gere cada senha/segredo com:  openssl rand -hex 32
# (use -hex: o base64 gera / + = e quebra as URLs abaixo)
# ─────────────────────────────────────────────────────────────

# ── Endereço público do site (sem barra no final) ────────────
NEXT_PUBLIC_APP_URL=https://www.kelvensousa.com.br
NEXTAUTH_URL=https://www.kelvensousa.com.br
NEXTAUTH_SECRET=TROQUE_openssl_rand_hex_32

# ── Banco de dados (PostgreSQL do docker-compose) ────────────
# A MESMA senha nas duas linhas. Host "postgres" = nome do serviço no compose.
POSTGRES_PASSWORD=TROQUE_senha_postgres
DATABASE_URL=postgresql://platform:TROQUE_senha_postgres@postgres:5432/platform?schema=public

# ── Redis (limite de tentativas de login/formulários) ────────
# A MESMA senha nas duas linhas. Note o ":" antes da senha.
REDIS_PASSWORD=TROQUE_senha_redis
REDIS_URL=redis://:TROQUE_senha_redis@redis:6379

# ── Administrador inicial (criado pelo serviço migrate) ──────
SEED_ADMIN_EMAIL=seu-email@exemplo.com
SEED_ADMIN_PASSWORD=TROQUE_minimo_12_caracteres

# ── Stripe (comece com chaves de TESTE: sk_test_ / whsec_) ────
STRIPE_SECRET_KEY=sk_test_TROQUE
STRIPE_WEBHOOK_SECRET=whsec_TROQUE

# ── Asaas (reais: Pix, boleto e cartão BR) ──────────────────
# Comece no SANDBOX. Para produção, troque a URL e use a chave de produção.
#   Sandbox:  https://api-sandbox.asaas.com/v3
#   Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Cole a chave SEM o "$" do início (ex.: aact_hmlg_000...). O "$" confunde o
# Docker e o Next (viram variáveis); o código adiciona o "$" sozinho.
ASAAS_API_KEY=TROQUE_aact_sem_cifrao
# Senha do webhook (32 a 255 caracteres). Gere com: openssl rand -hex 32
# Cole o MESMO valor no campo "Token de autenticação" do webhook no Asaas.
ASAAS_WEBHOOK_TOKEN=TROQUE_openssl_rand_hex_32
# true = após pagar, o Asaas devolve o cliente ao site. Só ative depois de
# cadastrar o domínio em Asaas > Configurações da conta > Informações.
ASAAS_SUCCESS_REDIRECT=false

# ── Login social (opcional; sem valor, o botão não aparece) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ── Dados públicos (embutidos no build: defina ANTES do build) ─
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_COMPANY_NAME=Kelven Studio
NEXT_PUBLIC_COMPANY_DOCUMENT=
NEXT_PUBLIC_COMPANY_ADDRESS=

# ── Nginx ────────────────────────────────────────────────────
# Primeiro deploy (sem certificado): deixe esta linha ativa.
# Depois de emitir o certificado Let's Encrypt, apague-a.
NGINX_CONF=nginx.http-only.conf

# ── Armazenamento S3/MinIO (opcional, ainda não usado) ───────
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
